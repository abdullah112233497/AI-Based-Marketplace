# ==============================================================================
# AI-Powered Tech Marketplace — Backend Configuration Template
# Phase 1: Foundation (Copy to .env for local development)
# ==============================================================================

# Application Settings
APP_NAME="AI Tech Marketplace API"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL with asyncpg)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/tech_marketplace
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# CORS Allowed Origins (JSON Array or Comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ==============================================================================
# Future Phase Placeholders (Do not use in Phase 1)
# ==============================================================================
# Phase 2: Authentication & Identity
JWT_SECRET_KEY=change_me_to_a_random_64_character_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_COOKIE_NAME=auth_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Phase 3+: Cloud Storage & Media
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Phase 4: AI Layer
# GEMINI_API_KEY=your_gemini_api_key_here

# Phase 5: Automation (n8n Cloud)
# N8N_WEBHOOK_BASE_URL=https://your-instance.app.n8n.cloud/webhook
# N8N_WEBHOOK_SECRET=your_hmac_secret_here
